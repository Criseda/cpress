# cpress formatting. Run: clang-format -i <files>
# See docs/style.md for the conventions a formatter cannot enforce.
BasedOnStyle: Google
Language: Cpp
Standard: c++20

IndentWidth: 4
ColumnLimit: 100
AccessModifierOffset: -4
ContinuationIndentWidth: 4

PointerAlignment: Left
DerivePointerAlignment: false

# One statement per line for functions; short guards and lambdas may stay inline.
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: true
AllowShortLambdasOnASingleLine: All
AllowShortBlocksOnASingleLine: Empty

# Include order is written by hand: own header, project headers, standard library.
IncludeBlocks: Preserve
SortIncludes: CaseSensitive

InsertNewlineAtEOF: true
